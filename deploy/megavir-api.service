[Unit]
Description=MegavirTrace API (FastAPI)
After=network.target postgresql.service

[Service]
User=megavir
WorkingDirectory=/opt/megavirtrace
EnvironmentFile=/opt/megavirtrace/.env
Environment=MEGAVIR_TRUST_PROXY=1
Environment=MEGAVIR_ROOT_PATH=/api
ExecStart=/opt/megavirtrace/.venv/bin/uvicorn megavir.api.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/megavirtrace/data

[Install]
WantedBy=multi-user.target
