# Copy to .env (never commit .env).  All settings are read by the API and the ingest jobs.

MEGAVIR_DATABASE_URL=postgresql://megavir:megavir@localhost:5433/megavir
# Origins allowed to POST (the strict Origin check).  In production: your site's https origin.
MEGAVIR_ALLOWED_ORIGINS=["http://localhost:3000"]
# Which grid versions the API serves: real, test, synthetic
MEGAVIR_SERVE_KINDS=["real","test"]
# Behind nginx: trust X-Real-IP for per-visitor limits, and serve the API docs under /api
MEGAVIR_TRUST_PROXY=0
MEGAVIR_ROOT_PATH=

# --- Optional AI scientist (off unless a provider and key are set) -------------------------
# provider: zai (default service), openai, openai_compatible, anthropic, or none
MEGAVIR_AI_PROVIDER=none
MEGAVIR_AI_MODEL=
MEGAVIR_AI_API_KEY=
# only for openai_compatible (must be https)
MEGAVIR_AI_BASE_URL=
MEGAVIR_AI_HOURLY_LIMIT_PER_IP=20
MEGAVIR_AI_DAILY_CAP=500
MEGAVIR_AI_MAX_TOKENS=1200

# --- NASA Earthdata Login (ingest only; free account at https://urs.earthdata.nasa.gov) -----
# Either a token, or username and password, or a ~/.netrc entry for urs.earthdata.nasa.gov.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
